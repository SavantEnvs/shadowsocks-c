# BuildKit override of upstream's root .dockerignore (which drops .git and tests/, both needed here:
# the image carries the full history, and build.sh builds the upstream unit tests).

# ── Build outputs / local cruft ──────────────────────────────────────────────
# Keep build artifacts out of the context — the COPY boundary is what separates
# source from artifacts. build.sh produces its outputs under /mayhem at build time.
# Adjust the patterns per project.
build/
build-*/
out/
*.o
*.a
*.so
*.dylib
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
